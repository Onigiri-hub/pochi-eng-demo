# テキストファイルは自動判定し、リポジトリ内はLFで統一する
* text=auto eol=lf

# 明示的にテキスト扱いするファイル
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.svg   text eol=lf

# バイナリファイル（改行変換・差分表示を無効化）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
